{
    "name": "lisachenko/php-shared-data-extension",
    "description": "Shared data extension for PHP: persistent memory and request-surviving objects",
    "type": "library",
    "require": {
        "lisachenko/z-engine": "dev-master || ^8.4",
        "php": "~8.4.0",
        "ext-ffi": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.2"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Lisachenko Alexander",
            "email": "lisachenko.it@gmail.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "Lisachenko\\SharedData\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Lisachenko\\SharedData\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
